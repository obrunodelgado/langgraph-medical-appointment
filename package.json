{
  "name": "prompt-chaining-article-generator",
  "version": "1.0.0",
  "description": "Technical article generator using LangChain prompt chaining with reusable templates",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "node --env-file .env src/index.ts",
    "dev": "node --watch --inspect --env-file .env src/index.ts",
    "test": "node --env-file .env --test tests/**/*.test.ts",
    "test:dev": "node --inspect --env-file .env --test --watch tests/**/*.test.ts",
    "test:unit:dev": "node --inspect --test --watch tests/**/*unit.test.ts",
    "test:unit": "node --inspect --test tests/**/*unit.test.ts",
    "test:e2e:dev": "node --inspect --env-file .env --test --watch tests/**/*e2e.test.ts",
    "test:e2e": "node --inspect --env-file .env --test tests/**/*e2e.test.ts",
    "langgraph:serve": "npx @langchain/langgraph-cli@latest dev"
  },
  "keywords": [
    "langchain",
    "prompt-chaining",
    "article-generator",
    "openrouter",
    "ollama"
  ],
  "author": "erickwendel",
  "license": "MIT",
  "dependencies": {
    "@langchain/core": "^1.2.14",
    "@langchain/langgraph": "^1.4.19",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@langchain/langgraph-sdk": "^1.12.1",
    "@langchain/openai": "^1.6.2",
    "@openrouter/sdk": "^1.4.21",
    "fastify": "^5.12.5",
    "langchain": "^1.5.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.5.1",
    "@types/node": "^24.10.12"
  },
  "engines": {
    "node": ">=24.10.0"
  },
  "allowScripts": {
    "@openrouter/sdk@0.5.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
